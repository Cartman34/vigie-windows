<!DOCTYPE html>
<!-- @author Florent HAZARD <f.hazard@sowapps.com> -->
<!--
    Intent: the whole panel -- every card the user reads and every button they press, in
    one page served by the server app. It holds no measurement of its own: it renders what
    the back end states and sends back what the user asks for.
    Usage: open it to change what is DISPLAYED; a value, a threshold or a judgement belongs
    to a probe, never here. It has no build step and no dependency: what is written is what
    runs, and scripts/dev/check-front.ps1 says whether it still parses.
-->
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vigie</title>
<!-- Served by the back end's /favicon.ico route, which reads again the .ico DELIVERED with the
     client app: one single rendering of the brand, not one more copy (D15). -->
<link rel="icon" href="/favicon.ico?v=$($data.build)" sizes="any">
<!--
  A VIEW, rendered by the server app (D132, UI-RENDER). What is written between `$( and )
  is evaluated when the page is served; everything else is sent as it stands. The session
  token, the version, the build stamp and the labels arrive that way -- no marker is
  replaced in a string any more.
  It knows ONLY the REST contract (apps/backend-pode/api/openapi.yaml), and it is read
  through the server -> http://127.0.0.1:47600. A view is not a file to open (D47).
  When the back end does not answer, the script falls back on mock/state.json, and the
  stripe under the header turns amber to say so.
-->
<script>
  window.API_TOKEN = "$($data.token)";
  window.API_BASE  = "/api/v1";
  // Two distinct values, two uses: APP_VERSION is DISPLAYED (readable, coming from git),
  // APP_BUILD serves ONLY to detect that a new version is being served. Confusing them
  // forced a change token to be displayed -- "version 639231069781032063".
  window.APP_VERSION = "$($data.version)";
  window.APP_BUILD   = "$($data.build)";

  // ---- THE LABELS -----------------------------------------------------------------
  // The French text no longer lives here: it is in lang/fr.json, shared with the
  // PowerShell scripts. The server hands it to this view, so the labels are available
  // BEFORE the first line of code that displays anything at all -- a fetch at startup
  // would add a round trip AND a race, where the first rendering can arrive before the
  // labels.
  //
  // The try/catch covers the only case where nothing was handed over: a view rendered
  // without its labels. We fall back on the keys rather than breaking the whole page --
  // a panel with "[?ui.actualiser]" on its buttons is still a panel one can read.
  try { window.__LABELS = $($data.labels); } catch (e) { window.__LABELS = {}; }

  // L('key', value, ...): the label, with its holes {0} {1} filled in order.
  // A missing key gives "[?key]" -- visible and searchable, NEVER an empty string:
  // a message that disappears in silence is worse than the fault it was hiding.
  window.L = function (key) {
    var text = window.__LABELS && window.__LABELS[key];
    if (text === undefined) { return '[?' + key + ']'; }
    var vals = Array.prototype.slice.call(arguments, 1);
    return text.replace(/\{(\d+)\}/g, function (m, i) {
      return vals[+i] === undefined ? m : String(vals[+i]);
    });
  };

  // The static text of the HTML carries 'data-i18n="key"'; we fill it on load.
  // 'data-i18n-attr="title:key"' does the same for an attribute.
  window.applyLabels = function (root) {
    (root || document).querySelectorAll('[data-i18n]').forEach(function (el) {
      el.textContent = window.L(el.getAttribute('data-i18n'));
    });
    (root || document).querySelectorAll('[data-i18n-attr]').forEach(function (el) {
      el.getAttribute('data-i18n-attr').split(';').forEach(function (pair) {
        var bits = pair.split(':');
        if (bits.length === 2) { el.setAttribute(bits[0].trim(), window.L(bits[1].trim())); }
      });
    });
  };
  document.addEventListener('DOMContentLoaded', function () { window.applyLabels(); });
</script>
<link rel="stylesheet" href="assets/css/panel.css">
</head>
<body>
<!-- The GitHub mark defined ONCE, reused through <use>. It appeared in three places:
     three copies of one drawing always end up drifting apart (D15). -->
<svg class="svg-sprite" aria-hidden="true"><symbol id="ghMark" viewBox="0 0 16 16"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></symbol></svg>
<!-- ================= Loading screen (D08) =================
     Marque "icone client v1 - jauge a graduations" (D01), etat "demarrage" (orange, fraction 0,50).
     Geometry identical to apps/client/assets/generate-icons.ps1, in fractions of a size of 100. -->
<div id="splash" role="status" aria-live="polite" aria-label="Chargement de Vigie" data-i18n-attr="aria-label:ui.chargement-de-vigie">
  <svg class="splash-mark" viewBox="0 0 100 100" aria-hidden="true">
    <defs>
      <!-- The track and the value arc share exactly the same path. -->
      <path id="gaugeArc" d="M 25.251 74.749 A 35 35 0 1 1 74.749 74.749"/>
    </defs>
    <circle cx="50" cy="50" r="45" fill="none" stroke="var(--ok)" stroke-opacity=".35" stroke-width="2.4"/>
    <use href="#gaugeArc" fill="none" stroke="var(--gauge-track)" stroke-width="11" stroke-linecap="round"/>
    <g stroke="var(--muted)" stroke-opacity=".35" stroke-width="2">
        <line x1="25.746" y1="74.254" x2="30.201" y2="69.799"/>
        <line x1="15.700" y1="50.000" x2="22.000" y2="50.000"/>
        <line x1="25.746" y1="25.746" x2="30.201" y2="30.201"/>
        <line x1="50.000" y1="15.700" x2="50.000" y2="22.000"/>
        <line x1="74.254" y1="25.746" x2="69.799" y2="30.201"/>
        <line x1="84.300" y1="50.000" x2="78.000" y2="50.000"/>
        <line x1="74.254" y1="74.254" x2="69.799" y2="69.799"/>
    </g>
    <use class="splash-arc-val" href="#gaugeArc" fill="none" stroke="var(--ok)" stroke-width="11" stroke-linecap="round"/>
    <g class="splash-needle" stroke-linecap="round">
      <line x1="54.243" y1="45.757" x2="27.231" y2="72.769" stroke="var(--ok-dark)" stroke-opacity=".95" stroke-width="9.8"/>
      <line x1="54.243" y1="45.757" x2="27.231" y2="72.769" stroke="var(--ok)" stroke-width="8.2"/>
    </g>
    <circle cx="50" cy="50" r="9.5" fill="var(--ok)"/>
    <circle cx="50" cy="50" r="4.2" fill="#f0f6fc"/>
  </svg>
  <div class="splash-id">
    <p class="splash-name">Vigie</p>
    <p class="splash-sub" id="splashSub" data-i18n="ui.tableau-de-bord-local">Tableau de bord local</p>
  </div>
  <div class="splash-bar"><i></i></div>
  <p class="splash-foot"><a class="repo-ic" data-repo-link aria-label="Depot du projet sur GitHub" data-i18n-attr="aria-label:ui.depot-du-projet-sur"><svg width="16" height="16" aria-hidden="true"><use href="#ghMark"/></svg></a></p>
</div>
<header>
  <div class="title"><span id="appTitle">…</span> <small>Vigie</small></div>
  <div class="global" id="global"><span class="dot"></span><span id="globalTxt">—</span></div>
  <div class="spacer"></div>
  <div class="meta" id="lastRefresh">—</div>
  <button id="btnRefresh" class="ic-btn" onclick="panel.refresh(true)" aria-label="Actualiser" title="Actualiser : recalcule toutes les sondes sans utiliser le cache (peut prendre plusieurs minutes)" data-i18n-attr="title:ui.actualiser-recalcule-toutes-les"><span class="vi vi-fw">&#xE008;</span></button>
  <button class="bell" id="bellBtn" onclick="panel.toggleDrawer()" title="Notifications">
    <span class="vi vi-fw vi-lg">&#xE004;</span>
    <span id="bellCount" class="bell-count"></span>
  </button>
  <a class="ic-btn" id="atelierBtn" target="_blank" rel="noopener" hidden title="Ouvrir l’atelier de validation (détecté en local)" data-i18n-attr="title:ui.ouvrir-atelier-de-validation">⚒</a>
  <button class="ic-btn" id="settingsBtn" onclick="panel.openSettings()" aria-label="Paramètres" title="Paramètres : notifications, modules, apparence, à propos" data-i18n-attr="title:ui.parametres-notifications-modules-apparence;aria-label:ui.parametres"><span class="vi vi-fw">&#xE001;</span></button>
</header>
<div class="modebar neutral" id="modebar"></div>
<main id="app"></main>
<footer class="appfoot">
  <span>Vigie</span><span class="sep">·</span>
  <span id="footVersion"></span>
  <span class="spacer"></span>
  <button onclick="panel.toggleTheme()" id="themeBtn" class="ic-btn" title="Basculer entre le thème sombre et le thème clair" data-i18n-attr="title:ui.basculer-entre-le-theme"><span class="vi vi-fw" id="themeIc">&#xE005;</span></button>
  <a class="repo-ic" data-repo-link aria-label="Depot du projet sur GitHub" data-i18n-attr="aria-label:ui.depot-du-projet-sur"><svg width="16" height="16" aria-hidden="true"><use href="#ghMark"/></svg></a>
</footer>
<div class="toast-stack" id="toastStack"></div>
<div class="drawer-back" id="drawerBack" onclick="panel.toggleDrawer()"></div>
<aside class="drawer" id="drawer" aria-label="Notifications">
  <div class="drawer-head"><span>Notifications</span>
    <button class="drawer-clear" onclick="panel.clearNotifs()" title="Tout effacer" data-i18n="ui.tout-effacer" data-i18n-attr="title:ui.tout-effacer">Tout effacer</button>
    <button class="drawer-x" onclick="panel.toggleDrawer()" title="Fermer" aria-label="Fermer">×</button></div>
  <div class="drawer-body" id="drawerBody"></div>
</aside>
<div class="drawer-back" id="settingsBack" onclick="panel.toggleSettings()"></div>
<aside class="drawer" id="settingsDrawer" aria-label="Paramètres">
  <div class="drawer-head"><span data-i18n="ui.parametres">Paramètres</span>
    <button class="drawer-x" onclick="panel.toggleSettings()" title="Fermer" aria-label="Fermer">×</button></div>
  <div class="drawer-body" id="settingsBody"></div>
</aside>
<div class="hds-back" id="hdsBack">
  <div class="hds-dialog" role="dialog" aria-modal="true" aria-labelledby="hdsTitle">
    <div class="hds-dialog-head"><span class="hds-dialog-ic" id="hdsIc"></span><span id="hdsTitle"></span><button class="hds-x" id="hdsX" title="Fermer" aria-label="Fermer">×</button></div>
    <div class="hds-dialog-body" id="hdsBody"></div>
    <div class="hds-dialog-foot" id="hdsFoot"></div>
  </div>
</div>

<!-- A MODULE, which is what makes `import` legal in a browser, and what keeps the panel's names out of the
     global scope (D132, UI-MODULES). A module is deferred by design: it runs once the markup is parsed, as
     this script already did by sitting at the end of the body. -->
<script type="module" src="assets/js/panel.js"></script>
</body>
</html>
