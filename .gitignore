# --- Secrets & etat local (NE JAMAIS committer) ---
# Un dossier d'app peut etre renomme (D30) : on ignore par MOTIF, pas par chemin
# exact, pour qu'un renommage ne fasse plus passer un fichier local a travers.
# var/ = tout ce qu'une app genere ou gere en local (cache, journaux, etat,
# secrets generes). Convention Symfony. Jamais versionne.
apps/*/var/
# Config propre a la machine, jamais versionnee (le modele .sample l'est).
# Motif VOLONTAIREMENT large : ce fichier s'est retrouve suivi DEUX fois, chaque
# fois parce qu'un motif trop precis ne couvrait plus l'emplacement d'ou il venait
# d'etre deplace. Ici, quel que soit son dossier, il est ignore.
**/config.local.psd1
# Reglages locaux ecrits par le backend (notifications, modules...) : meme statut.
config/*.local.json
config/*.local.psd1

# --- Sorties de fabrication ---
# Archives de distribution produites par scripts/build-release.ps1. Elles se refabriquent
# a l'identique depuis les sources : les versionner ferait grossir le depot pour rien.
dist/

# TOUT ce qui est local vit ici, et rien n'en sort : file de travail, notes, essais.
# Cela change a chaque session et n'appartient qu'a cette machine -- ca n'a rien a
# faire dans l'historique.
/local/

# --- Sauvegardes locales creees pendant l'edition ---
*.bak-*
**/.bak-*/
.bak-*/

# --- Agent (Claude Code) ---
# .claude/settings.json EST versionne : c'est le reglage du projet (D40).
# Le reste est local a la machine ou a une session, jamais partage.
.claude/worktrees/
.claude/settings.local.json

# --- Reglages d'editeurs / IDE (jamais versionnes) ---
# PhpStorm pose deja son propre .idea/.gitignore, qui exclut le volatil et le
# sensible (workspace.xml, dataSources* ou atterriraient des identifiants).
# On ignore ici le dossier ENTIER : l'IDE ne sert pas a editer ce projet, et des
# reglages d'editeur versionnes finissent toujours par diverger d'un poste a l'autre.
# Si un jour on veut partager la config IDE, le sous-ensemble a versionner serait
# vcs.xml, modules.xml, *.iml et misc.xml -- JAMAIS workspace.xml ni dataSources*.
.idea/
.vscode/
*.code-workspace

# --- Divers ---
__pycache__/
*.pyc
node_modules/
Thumbs.db
desktop.ini
*.log
